# Optional Google OAuth connection. Keep real values in environment configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Enable for an HTTPS deployment. Without an override, NODE_ENV=production
# enables Secure cookies and HSTS. Explicit false is for local HTTP development.
COOKIE_SECURE=false
# API_PORT=4174 in development; PORT=4173 with npm start for the built app.
# API_HOST defaults to 127.0.0.1 during development; Vite proxies /api.
